{
    "name": "astrx/module-onionsearch",
    "description": "Search page backed by the astrx-suite onion crawler",
    "type": "astrx-module",
    "keywords": [
        "astrx",
        "no-javascript",
        "server-rendered",
        "astrx-module"
    ],
    "homepage": "https://github.com/Vxmdzhb/module-onionsearch",
    "require": {
        "php": ">=8.4",
        "astrx/cms": "self.version",
        "astrx/framework": "self.version",
        "astrx/library": "self.version",
        "astrx/module-search": "self.version"
    },
    "autoload": {
        "psr-4": {
            "AstrX\\OnionSearch\\": ""
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/cms"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/framework"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/library"
        },
        {
            "type": "vcs",
            "url": "https://github.com/Vxmdzhb/module-search"
        }
    ]
}
